# =============================================================================
# .env.company.example — plantilla de variables para docker-compose.company.yml.
#
# Copia a `.env.company` (NUNCA se commitea; ya está en .gitignore) y rellena los
# valores. NO escribas credenciales reales en este archivo de ejemplo.
# =============================================================================

# --- Entorno del contenedor de la app ---
NODE_ENV=production
APP_PORT=3000

# --- Postgres del chatbot (contenedor `db`) ---
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=cambia_esta_clave_de_demo
POSTGRES_DB=chatbot_db

# --- Dominio público (obligatorio para enlaces de login y webhooks) ---
PUBLIC_BASE_URL=https://chatbot.empresa.example
# CORS: orígenes permitidos (https en producción). Vacío => solo mismo origen.
ALLOWED_ORIGINS=
# Proxy inverso delante (Nginx/Traefik): true para que el rate-limit vea la IP real.
TRUST_PROXY=true

# --- Canales: web | whatsapp | telegram | both | lista con comas ---
CHANNEL_MODE=telegram

# --- Telegram (obligatorio si CHANNEL_MODE incluye telegram) ---
TELEGRAM_BOT_TOKEN=
# 1-256 caracteres: A-Z a-z 0-9 _ - ; el mismo valor que secret_token al setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# true => omite la coincidencia de teléfono en Telegram (chat.id no es teléfono).
TELEGRAM_SKIP_PHONE_MATCH=

# --- WhatsApp (solo si CHANNEL_MODE incluye whatsapp) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SUPPORT_PHONE=
WHATSAPP_TEMPLATE_NAME=

# --- Admin inicial (se crea al arrancar si aún no existe ningún ADMIN) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Usuario de empresa de EJEMPLO (solo seed; credenciales ficticias) ---
COMPANY_SEED_USERNAME=
COMPANY_SEED_PASSWORD=
COMPANY_SEED_DISPLAY_NAME=
COMPANY_SEED_PHONE=570000000001

# --- Identidad del chat ---
LOGIN_LINK_TTL_MINUTES=10
CHAT_SESSION_IDLE_MINUTES=20
CHAT_SESSION_ABSOLUTE_HOURS=8
REQUIRE_PHONE_MATCH=

# --- IA local (Ollama) ---
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_MS=10000

# --- BD de la empresa (solo lectura). Vacío => consultas de datos deshabilitadas ---
# En modo demo (--profile demo), apunta al contenedor company-demo-db:
#   COMPANY_DATABASE_URL=postgresql://company_readonly:solo_demo_readonly@company-demo-db:5432/company_demo
# En producción real, apunta al servidor de la empresa (usuario solo lectura):
COMPANY_DATABASE_URL=
COMPANY_QUERY_TIMEOUT_MS=3000
COMPANY_MAX_ROWS=50

# --- Solo para el contenedor de BD de demostración (perfil `demo`) ---
COMPANY_DEMO_ADMIN_USER=company_admin
COMPANY_DEMO_ADMIN_PASSWORD=cambia_esta_clave_de_demo
COMPANY_DEMO_DB=company_demo
COMPANY_READONLY_PASSWORD=solo_demo_readonly
COMPANY_READONLY_ROLE=company_readonly
