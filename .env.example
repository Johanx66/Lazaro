# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (sin servidor Postgres local aún, migración queda pendiente de aplicar)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot?schema=public

# WhatsApp Business Cloud API (sin credenciales => modo MOCK con log explícito)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Secreto de la app de Meta: firma X-Hub-Signature-256 del webhook (obligatorio en producción con whatsapp)
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Línea interna para notificar al soporte/agente cuando una conversación escala
WHATSAPP_SUPPORT_PHONE=

# Botpress (sin credenciales => modo MOCK con log explícito)
BOTPRESS_WEBHOOK_SECRET=
BOTPRESS_WEBHOOK_URL=

# Canales: web | whatsapp | telegram | both (alias web+whatsapp) | lista con comas
# (ej: whatsapp,telegram). Default: both en dev, whatsapp en prod. En producción no se
# admite ningún modo que incluya "web" (el simulador /dev/chat no se monta).
CHANNEL_MODE=both

# Confianza mínima (0 a 1) para que el bot responda con una FAQ; vacío => 0.5
FAQ_MIN_CONFIDENCE=0.5

# Número de fallos consecutivos sin entender antes de transferir; vacío => 3
TRANSFER_AFTER_MISSES=3

# Nombre de la plantilla HSM de WhatsApp para reabrir ventana de 24h (opcional)
WHATSAPP_TEMPLATE_NAME=

# CORS: orígenes permitidos separados por comas (esquema://host[:puerto], sin ruta ni "*").
# Vacío => sin CORS (solo mismo origen). En producción solo https://.
ALLOWED_ORIGINS=https://panel.empresa.example

# Conectores de salida: webhook que recibe las escalaciones a agente (vacío => no se envía)
NOTIFICATION_WEBHOOK_URL=
# Primer administrador del panel. Se usa al ejecutar el seed y también al ARRANCAR
# la app: si están definidos y aún no existe ningún usuario ADMIN, se crea en ese
# momento (idempotente; nunca sobrescribe uno existente). Contraseña mínimo 12 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Usuario de empresa de EJEMPLO para probar el login del chat (solo se usa al ejecutar el seed).
# Nunca uses credenciales reales aquí. Contraseña mínimo 12 caracteres.
COMPANY_SEED_USERNAME=
COMPANY_SEED_PASSWORD=
COMPANY_SEED_DISPLAY_NAME=
# Teléfono autorizado del usuario de ejemplo (debe coincidir con el contacto del chat si REQUIRE_PHONE_MATCH)
COMPANY_SEED_PHONE=570000000001

# Identidad del chat: base pública absoluta para construir el enlace de login (sin barra final)
PUBLIC_BASE_URL=http://localhost:3000
# Minutos de validez de un enlace de login de un solo uso; vacío => 10
LOGIN_LINK_TTL_MINUTES=10
# Minutos de inactividad antes de vencer una sesión de chat; vacío => 20
CHAT_SESSION_IDLE_MINUTES=20
# Horas de tope absoluto de una sesión de chat aunque haya actividad; vacío => 8
CHAT_SESSION_ABSOLUTE_HOURS=8
# Exigir que el teléfono del chat coincida con el registrado del usuario.
# Vacío => true en producción, false en desarrollo
REQUIRE_PHONE_MATCH=

# Telegram (sin credenciales => el canal no se monta en dev, modo MOCK con log explícito)
# Token del bot de BotFather (obligatorio en producción si CHANNEL_MODE incluye telegram)
TELEGRAM_BOT_TOKEN=
# Secreto del webhook: mismo valor que secret_token al llamar a setWebhook.
# 1-256 caracteres: letras, dígitos, '-' o '_' (obligatorio en producción con telegram)
TELEGRAM_WEBHOOK_SECRET=
# true => omite la coincidencia de teléfono cuando el canal es TELEGRAM (el identificador
# del chat es un chat.id, no un teléfono). Por defecto false: la coincidencia sigue exigiéndose.
TELEGRAM_SKIP_PHONE_MATCH=

# Confiar en X-Forwarded-For (poner true SOLO si hay un proxy inverso delante).
# Necesario para que el rate-limit vea la IP real. Vacío => false
TRUST_PROXY=

# Fase 5 - IA local (Ollama). El bot clasifica intenciones y redacta respuestas.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Tiempo máximo de espera del modelo en ms; vacío => 10000
LLM_TIMEOUT_MS=10000

# Proveedor de IA: ollama (IA LOCAL: por defecto y en producción en la empresa)
# | cloudflare (Cloudflare Workers AI: SOLO pruebas con datos FICTICIOS, porque el
# prompt y los datos salen del servidor de la empresa hacia un tercero).
LLM_PROVIDER=ollama
# Credenciales de Cloudflare Workers AI (obligatorias si LLM_PROVIDER=cloudflare).
# El token NUNCA se registra en logs. Usa un token de pruebas, no uno de producción.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Modelo de Workers AI (<= 8B, buen en español, baja latencia).
LLM_MODEL=@cf/meta/llama-3.2-3b-instruct

# Fase 5 - BD de la empresa (solo lectura). Vacío => consultas de datos deshabilitadas
# (el bot usa palabras clave y no llama a Ollama).
COMPANY_DATABASE_URL=
# Tiempo máximo por consulta en ms; vacío => 3000
COMPANY_QUERY_TIMEOUT_MS=3000
# Máximo de filas devueltas al modelo por consulta; vacío => 50
COMPANY_MAX_ROWS=50
# Patrón (expresión regular) que debe cumplir el código de cliente de la BD de la
# empresa para vincularlo a un usuario del bot. Vacío => patrón por defecto
# (^[A-Z0-9][A-Z0-9_-]{1,31}$). El código se normaliza a mayúsculas.
COMPANY_CUSTOMER_ID_PATTERN=
